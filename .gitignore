# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Argus
.env.local
samples/**/*.jpg
samples/**/*.jpeg
samples/**/*.png
samples/**/*.webp
samples/**/report.json
samples/**/pms.json
docs/media/*.mp3
docs/media/cards/*.html
docs/media/raw/
docs/media/work/
docs/media/*.mp4
docs/media/kitchens/
docs/media/screenshots/debug-*.png
